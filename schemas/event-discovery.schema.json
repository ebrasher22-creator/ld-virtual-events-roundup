{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "audience",
      "discovered_at",
      "discovered_by",
      "event_format",
      "event_url",
      "evidence",
      "language",
      "organizer",
      "price_type",
      "registration_url",
      "source_urls",
      "start_datetime",
      "summary",
      "timezone",
      "title",
      "topics"
    ],
    "properties": {
      "event_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "organizer": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "organizer_url": {
        "type": [
          "string",
          "null"
        ],
        "format": "uri",
        "pattern": "^https?://"
      },
      "event_url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      },
      "registration_url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      },
      "start_datetime": {
        "type": "string",
        "format": "date-time",
        "description": "RFC3339 timestamp with explicit numeric offset or Z. Local offsets must match the IANA timezone; UTC Z is accepted."
      },
      "end_datetime": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "timezone": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "description": "IANA timezone name, e.g. America/Chicago. Never CST or Central Time."
      },
      "event_format": {
        "enum": [
          "virtual",
          "hybrid",
          "in_person",
          "on_demand"
        ]
      },
      "language": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "price_type": {
        "enum": [
          "free",
          "paid",
          "unknown"
        ]
      },
      "cost": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "audience": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "topics": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "discovered_by": {
        "type": "array",
        "items": {
          "enum": [
            "chatgpt",
            "antigravity",
            "gemini"
          ]
        },
        "minItems": 1,
        "uniqueItems": true,
        "description": "Discovery stream. 'chatgpt' and 'antigravity' are the production agents. 'gemini' is a legacy identity retained only for historical Antigravity-stream records under intake/gemini/."
      },
      "source_urls": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uri"
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "discovered_at": {
        "type": "string",
        "format": "date-time"
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "claim",
            "source_url",
            "excerpt"
          ],
          "properties": {
            "claim": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "source_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            "excerpt": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        },
        "minItems": 1
      },
      "verification_status": {
        "type": [
          "string",
          "null"
        ]
      },
      "last_verified_at": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "editorial_status": {
        "type": [
          "string",
          "null"
        ]
      },
      "editorial_score": {
        "type": [
          "number",
          "null"
        ]
      },
      "roundup_week": {
        "type": [
          "string",
          "null"
        ]
      },
      "conflict_flags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "updated_at": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      }
    },
    "additionalProperties": false
  }
}
